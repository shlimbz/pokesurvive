  "moveLevelRangeMult": {
    "comment": "Added 2026-10-02 (user feedback: a move already reaches its full range the instant it's learned at Lv1, so leveling it up only changed damage/VFX tier, not how far it reaches). Scales move.range/meleeRange by move level so a fresh Lv1 move visibly reaches less far and grows into its full listed range by max level (maxLevels.move = 3). Does not touch areaRadius/beamWidth/count/etc - those already grow via patternGrowth.",
    "byLevel": [0.6, 0.8, 1.0, 1.0, 1.0]
  },
  "moveLevelCooldownMult": {
    "comment": "Added 2026-10-02 (user feedback: Lv1 moves already fire at full attack speed, so leveling up only raised damage/range/VFX, never felt 'faster'). Multiplies BuildSystem.getMoveCooldownMs's result by move level - Lv1 fires noticeably slower (40% longer wait), ramping down to the move's real listed cooldownMs at max level (maxLevels.move = 3).",
    "byLevel": [1.4, 1.15, 1.0, 1.0, 1.0]
  },
